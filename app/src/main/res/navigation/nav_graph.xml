<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/welcomeFragment">

    <!-- ─── Main Tabs ─────────────────────────────────────── -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.hoode_app.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/exploreFragment"
        android:name="com.example.hoode_app.ui.explore.ExploreFragment"
        android:label="@string/nav_explore"
        tools:layout="@layout/fragment_explore" />

    <fragment
        android:id="@+id/createFragment"
        android:name="com.example.hoode_app.ui.create.CreateFragment"
        android:label="@string/nav_create"
        tools:layout="@layout/fragment_create" />

    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.example.hoode_app.ui.inbox.InboxFragment"
        android:label="@string/nav_inbox"
        tools:layout="@layout/fragment_inbox" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.hoode_app.ui.profile.ProfileFragment"
        android:label="@string/nav_profile"
        tools:layout="@layout/fragment_profile" />

    <!-- ─── Auth ─────────────────────────────────────────── -->
    <fragment
        android:id="@+id/welcomeFragment"
        android:name="com.example.hoode_app.ui.auth.WelcomeFragment"
        android:label="Welcome"
        tools:layout="@layout/fragment_welcome">
        <action
            android:id="@+id/action_welcome_to_signIn"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_welcome_to_signUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_welcome_to_googleSignIn"
            app:destination="@id/googleSignInFragment" />
        <action
            android:id="@+id/action_welcome_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/signInFragment"
        android:name="com.example.hoode_app.ui.auth.SignInFragment"
        android:label="Sign In"
        tools:layout="@layout/fragment_signin">
        <action
            android:id="@+id/action_signIn_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signIn_to_signUp"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_signIn_to_googleSignIn"
            app:destination="@id/googleSignInFragment" />
    </fragment>

    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.hoode_app.ui.auth.SignUpFragment"
        android:label="Sign Up"
        tools:layout="@layout/fragment_signup">
        <action
            android:id="@+id/action_signUp_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_signUp_to_signIn"
            app:destination="@id/signInFragment" />
        <action
            android:id="@+id/action_signUp_to_googleSignIn"
            app:destination="@id/googleSignInFragment" />
    </fragment>

    <fragment
        android:id="@+id/googleSignInFragment"
        android:name="com.example.hoode_app.ui.auth.GoogleSignInFragment"
        android:label="Google Sign In"
        tools:layout="@layout/fragment_google_sign_in">
        <action
            android:id="@+id/action_googleSignIn_to_home"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/nav_graph"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- ─── Feature Modules (F01–F20) ───────────────────────── -->
    <fragment
        android:id="@+id/prayerDetailFragment"
        android:name="com.example.hoode_app.ui.prayer.PrayerDetailFragment"
        android:label="@string/feature_prayer"
        tools:layout="@layout/fragment_prayer_detail" />

    <fragment
        android:id="@+id/emergencyFragment"
        android:name="com.example.hoode_app.ui.emergency.EmergencyFragment"
        android:label="@string/feature_emergency"
        tools:layout="@layout/fragment_emergency" />

    <fragment
        android:id="@+id/jobsFragment"
        android:name="com.example.hoode_app.ui.jobs.JobsFragment"
        android:label="@string/feature_jobs"
        tools:layout="@layout/fragment_jobs" />

    <fragment
        android:id="@+id/lostFoundFragment"
        android:name="com.example.hoode_app.ui.lostfound.LostFoundFragment"
        android:label="@string/feature_lost_found"
        tools:layout="@layout/fragment_lost_found" />

    <fragment
        android:id="@+id/tournamentsFragment"
        android:name="com.example.hoode_app.ui.tournaments.TournamentsFragment"
        android:label="@string/feature_tournaments"
        tools:layout="@layout/fragment_tournaments" />

    <fragment
        android:id="@+id/eventsFragment"
        android:name="com.example.hoode_app.ui.events.EventsFragment"
        android:label="@string/feature_events"
        tools:layout="@layout/fragment_events" />

    <fragment
        android:id="@+id/bloodNetworkFragment"
        android:name="com.example.hoode_app.ui.blood.BloodNetworkFragment"
        android:label="@string/feature_blood"
        tools:layout="@layout/fragment_blood_network" />

    <fragment
        android:id="@+id/pollsFragment"
        android:name="com.example.hoode_app.ui.polls.PollsFragment"
        android:label="@string/feature_polls"
        tools:layout="@layout/fragment_polls" />

    <fragment
        android:id="@+id/badgesFragment"
        android:name="com.example.hoode_app.ui.badges.BadgesFragment"
        android:label="@string/feature_badges"
        tools:layout="@layout/fragment_badges" />

    <fragment
        android:id="@+id/marketplaceFragment"
        android:name="com.example.hoode_app.ui.marketplace.MarketplaceFragment"
        android:label="@string/feature_classifieds"
        tools:layout="@layout/fragment_marketplace" />

    <fragment
        android:id="@+id/ramadanFragment"
        android:name="com.example.hoode_app.ui.ramadan.RamadanFragment"
        android:label="@string/feature_ramadan"
        tools:layout="@layout/fragment_ramadan" />

    <fragment
        android:id="@+id/notificationCenterFragment"
        android:name="com.example.hoode_app.ui.notifications.NotificationCenterFragment"
        android:label="Notifications"
        tools:layout="@layout/fragment_notification_center" />

    <fragment
        android:id="@+id/newsFragment"
        android:name="com.example.hoode_app.ui.news.NewsFragment"
        android:label="@string/feature_news"
        tools:layout="@layout/fragment_news" />

    <fragment
        android:id="@+id/providersFragment"
        android:name="com.example.hoode_app.ui.providers.ProvidersFragment"
        android:label="@string/feature_providers"
        tools:layout="@layout/fragment_providers" />

    <fragment
        android:id="@+id/personalityDetailFragment"
        android:name="com.example.hoode_app.ui.personality.PersonalityDetailFragment"
        android:label="@string/feature_personality"
        tools:layout="@layout/fragment_personality_detail" />

    <fragment
        android:id="@+id/galleryFragment"
        android:name="com.example.hoode_app.ui.gallery.GalleryFragment"
        android:label="@string/feature_gallery"
        tools:layout="@layout/fragment_gallery" />

    <fragment
        android:id="@+id/activitiesFragment"
        android:name="com.example.hoode_app.ui.activities.ActivitiesFragment"
        android:label="@string/feature_activities"
        tools:layout="@layout/fragment_activities" />

    <fragment
        android:id="@+id/educationFragment"
        android:name="com.example.hoode_app.ui.education.EducationFragment"
        android:label="@string/feature_education"
        tools:layout="@layout/fragment_education" />

    <fragment
        android:id="@+id/huffazFragment"
        android:name="com.example.hoode_app.ui.huffaz.HuffazFragment"
        android:label="@string/feature_huffaz"
        tools:layout="@layout/fragment_huffaz" />

    <!-- ─── Admin Console ─────────────────────────────────── -->
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.hoode_app.ui.admin.AdminDashboardFragment"
        android:label="Admin Console"
        tools:layout="@layout/fragment_admin_dashboard">
        <action
            android:id="@+id/action_admin_to_carousel"
            app:destination="@id/adminCarouselFragment" />
        <action
            android:id="@+id/action_admin_to_prayer"
            app:destination="@id/adminPrayerFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminPrayerFragment"
        android:name="com.example.hoode_app.ui.admin.AdminPrayerFragment"
        android:label="Edit Prayer Timings"
        tools:layout="@layout/fragment_admin_prayer" />

    <fragment
        android:id="@+id/adminCarouselFragment"
        android:name="com.example.hoode_app.ui.admin.AdminCarouselFragment"
        android:label="Edit Ads Carousel"
        tools:layout="@layout/fragment_admin_carousel" />

    <fragment
        android:id="@+id/calendarFragment"
        android:name="com.example.hoode_app.ui.explore.CalendarFragment"
        android:label="Community Calendar"
        tools:layout="@layout/fragment_calendar" />

</navigation>
