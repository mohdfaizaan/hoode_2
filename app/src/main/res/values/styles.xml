<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ═══════════════════════════════════════════════════════ -->
    <!-- Hoode Connect — Canva-Inspired Component Styles         -->
    <!-- Soft elevated cards, Canva purple buttons, pill shapes  -->
    <!-- ═══════════════════════════════════════════════════════ -->

    <!-- ─── Cards ─────────────────────────────────────────── -->
    <style name="Widget.Hoode.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border_soft</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
        <item name="android:layout_marginStart">@dimen/screen_padding_horizontal</item>
        <item name="android:layout_marginEnd">@dimen/screen_padding_horizontal</item>
        <item name="android:layout_marginTop">@dimen/spacing_sm</item>
        <item name="android:layout_marginBottom">@dimen/spacing_sm</item>
    </style>

    <style name="Widget.Hoode.Card.Bordered" parent="Widget.Hoode.Card">
        <item name="strokeColor">@color/border_soft</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
    </style>

    <style name="Widget.Hoode.Card.Borderless" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_sm</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border_green</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
    </style>

    <style name="Widget.Hoode.Card.Accent" parent="Widget.Material3.CardView.Filled">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_xs</item>
        <item name="cardBackgroundColor">@color/accent_surface</item>
        <item name="strokeColor">@color/canva_pill_border</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
    </style>

    <style name="Widget.Hoode.Card.Flat" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/elevation_none</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border_soft</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
        <item name="contentPadding">@dimen/spacing_lg</item>
    </style>

    <!-- Carousel slide card -->
    <style name="Widget.Hoode.Card.Carousel" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card_lg</item>
        <item name="cardElevation">@dimen/elevation_md</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/border_soft</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
    </style>

    <!-- ─── Buttons ───────────────────────────────────────── -->
    <style name="Widget.Hoode.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="Widget.Hoode.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="strokeColor">@color/accent</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Hoode.Button.Accent" parent="Widget.Material3.Button">
        <item name="cornerRadius">24dp</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/accent_soft</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Widget.Hoode.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">24dp</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- ─── Chips ─────────────────────────────────────────── -->
    <style name="Widget.Hoode.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">@dimen/radius_chip</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/border_soft</item>
        <item name="chipStrokeWidth">@dimen/card_stroke</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- ─── Text Input ────────────────────────────────────── -->
    <style name="Widget.Hoode.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_input</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_input</item>
        <item name="boxStrokeColor">@color/border_soft</item>
        <item name="boxStrokeWidth">@dimen/card_stroke</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>

    <!-- ─── Bottom Navigation ─────────────────────────────── -->
    <style name="Widget.Hoode.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/surface</item>
        <item name="itemIconTint">@color/nav_selector</item>
        <item name="itemTextColor">@color/nav_selector</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.Hoode.BottomNav.Indicator</item>
        <item name="elevation">@dimen/elevation_lg</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.Hoode.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.Hoode.NavLabel</item>
    </style>

    <style name="Widget.Hoode.BottomNav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Hoode.Indicator</item>
    </style>

    <style name="ShapeAppearance.Hoode.Indicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_chip</item>
    </style>

    <!-- ─── Text Appearances ──────────────────────────────── -->
    <style name="TextAppearance.Hoode.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textColor">@color/accent_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Hoode.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textColor">@color/accent_ink</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Hoode.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Hoode.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Hoode.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">@dimen/text_sm</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Hoode.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">@dimen/text_xs</item>
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.Hoode.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textSize">11sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.Hoode.NavLabel.Active" parent="TextAppearance.Hoode.NavLabel">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nav_active</item>
    </style>

    <!-- ─── Section Header ────────────────────────────────── -->
    <style name="Widget.Hoode.SectionHeader" parent="">
        <item name="android:textAppearance">@style/TextAppearance.Hoode.Title</item>
        <item name="android:paddingStart">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/screen_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/spacing_xxl</item>
        <item name="android:paddingBottom">@dimen/spacing_sm</item>
    </style>

    <!-- ─── Quick Action Button ───────────────────────────── -->
    <style name="Widget.Hoode.QuickAction" parent="">
        <item name="android:gravity">center</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">@dimen/spacing_xs</item>
    </style>
</resources>
