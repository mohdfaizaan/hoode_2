<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Layer 1: Outermost diffused ambient shadow -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#141E293B" />
        </shape>
    </item>

    <!-- Layer 2: Gradient Story Ring (Gold to Coral Pink to Violet) -->
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:startColor="@color/accent"
                android:centerColor="@color/accent"
                android:endColor="@color/navy"
                android:type="linear" />
        </shape>
    </item>

    <!-- Layer 3: Pure white floating circular disc -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="oval">
            <solid android:color="@color/surface" />
        </shape>
    </item>
</layer-list>
