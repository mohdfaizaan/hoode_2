<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_bordered"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-bold"
                android:text="Emergency Blood Request"
                android:textColor="@color/danger"
                android:textSize="18sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Coordinator-verified community lifesaver alert"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btn_close_blood_req"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary"
                android:contentDescription="Close" />
        </FrameLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="12dp"
        android:background="@color/border_faint" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="520dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Blood Group Selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Blood Group Needed *"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/ll_blood_groups"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chip_bg_opos"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_chip_black_border"
                        android:gravity="center"
                        android:text="O+"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_apos"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="A+"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_bpos"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="B+"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_abpos"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="AB+"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_oneg"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="O-"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_aneg"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="A-"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_bneg"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="B-"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />

                    <TextView
                        android:id="@+id/chip_bg_abneg"
                        android:layout_width="48dp"
                        android:layout_height="34dp"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_chip_unselected"
                        android:gravity="center"
                        android:text="AB-"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Hospital Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_blood_hospital"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="Hospital / Clinic (e.g. Adarsh Hospital, Manipal) *"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/border_green"
                app:startIconDrawable="@drawable/ic_category_community"
                app:startIconTint="@color/accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_blood_hospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Patient Name & Units Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_blood_patient"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:hint="Patient / Attender"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/border_green"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/accent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_blood_patient"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_blood_units"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:hint="Units"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxStrokeColor="@color/border_green">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_blood_units"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="1"
                        android:textColor="@color/text_primary" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Emergency Phone Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_blood_phone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Emergency Coordinator / Contact Phone *"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusTopStart="14dp"
                app:boxStrokeColor="@color/border_green"
                app:startIconDrawable="@drawable/ic_phone"
                app:startIconTint="@color/accent">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_blood_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Coordinator verification prevents duplicate broadcasts and protects volunteer privacy."
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <!-- Submit Button (Red/Danger for Emergency) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit_blood_req"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/danger"
                android:text="🚨 Broadcast Emergency Call"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_blood"
                app:iconTint="@color/white" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
