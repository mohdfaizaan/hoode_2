<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">

    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

        <!-- ── OLX-style top bar ────────────────────────────── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="18dp" android:paddingTop="14dp" android:paddingBottom="4dp">
            <ImageView android:id="@+id/btn_back" android:layout_width="42dp" android:layout_height="42dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="10dp" android:src="@drawable/ic_arrow_back" app:tint="@color/text_primary" android:contentDescription="@string/cd_back" android:focusable="true" android:minHeight="48dp" android:minWidth="48dp" android:clickable="true" android:foreground="?attr/selectableItemBackground" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/feature_classifieds" android:textColor="@color/text_primary" android:textSize="24sp" android:textStyle="bold" android:fontFamily="sans-serif" />
        </LinearLayout>

        <!-- ── Bordered search field ────────────────────────── -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginHorizontal="18dp" android:layout_marginTop="10dp" android:background="@drawable/bg_search_olx" android:gravity="center_vertical" android:paddingHorizontal="14dp" android:orientation="horizontal">
            <ImageView android:layout_width="@dimen/icon_sm" android:layout_height="@dimen/icon_sm" android:src="@drawable/ic_nav_explore" app:tint="@color/text_primary" android:importantForAccessibility="no" />
            <EditText android:id="@+id/et_search_marketplace" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="10dp" android:background="@null" android:hint='Search "bicycles, furniture, tools"' android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="@dimen/text_body" android:inputType="text" android:maxLines="1" />
        </LinearLayout>

        <!-- ── Category chips ───────────────────────────────── -->
        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:layout_marginTop="@dimen/spacing_sm" android:clipToPadding="false">
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="@dimen/spacing_xs">
                <TextView android:id="@+id/chip_market_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_selected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="All Items" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
                <TextView android:id="@+id/chip_market_vehicles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Vehicles" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
                <TextView android:id="@+id/chip_market_furniture" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Furniture" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
                <TextView android:id="@+id/chip_market_electronics" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Electronics" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
                <TextView android:id="@+id/chip_market_property" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Property &amp; Rentals" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
                <TextView android:id="@+id/chip_market_services" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Fishery &amp; Tools" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:layout_marginTop="@dimen/spacing_sm" android:text="Fresh recommendations" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />

        <!-- ── 2-column OLX grid ────────────────────────────── -->
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:fillViewport="true" android:scrollbars="none" android:overScrollMode="never">
            <GridLayout android:id="@+id/ll_marketplace_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="2" android:useDefaultMargins="true" android:paddingHorizontal="12dp" android:paddingTop="4dp" android:paddingBottom="@dimen/bottom_nav_content_padding" />
        </ScrollView>
    </LinearLayout>

    <!-- ── OLX-style floating "+" publish button ────────────── -->
    <FrameLayout android:id="@+id/btn_post_listing" android:layout_width="58dp" android:layout_height="58dp" android:layout_gravity="bottom|end" android:layout_marginEnd="18dp" android:layout_marginBottom="25dp" android:background="@drawable/bg_btn_fab" android:elevation="8dp" android:clickable="true" android:focusable="true" android:contentDescription="Post a new listing" android:foreground="?attr/selectableItemBackgroundBorderless">
        <ImageView android:layout_width="26dp" android:layout_height="26dp" android:layout_gravity="center" android:src="@drawable/ic_add" app:tint="@color/white" android:importantForAccessibility="no" />
    </FrameLayout>
</FrameLayout>
