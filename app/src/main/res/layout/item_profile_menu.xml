<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="62dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/spacing_lg"
    android:paddingVertical="@dimen/spacing_md"
    android:background="?attr/selectableItemBackground">

    <!-- Icon Squircle Container -->
    <FrameLayout
        android:id="@+id/fl_icon_container"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_quick_action">

        <ImageView
            android:id="@+id/iv_menu_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            tools:src="@drawable/ic_nav_profile" />
    </FrameLayout>

    <!-- Label & Subtitle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/spacing_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_menu_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            tools:text="My Posts &amp; Listings" />

        <TextView
            android:id="@+id/tv_menu_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Manage your classifieds and civic reports" />
    </LinearLayout>

    <!-- Contextual Badge / Value Pill -->
    <TextView
        android:id="@+id/tv_menu_badge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:background="@drawable/bg_pill_neutral"
        android:paddingHorizontal="10dp"
        android:paddingVertical="3dp"
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="sans-serif-medium"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="4 Active" />

    <!-- Chevron -->
    <ImageView
        android:id="@+id/iv_menu_chevron"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/ic_chevron_right"
        android:alpha="0.4"
        android:importantForAccessibility="no" />

</LinearLayout>
