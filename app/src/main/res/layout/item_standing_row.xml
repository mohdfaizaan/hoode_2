<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_bordered"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_sm"
    android:paddingHorizontal="@dimen/spacing_md"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_standing_team"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Kemmannu Kings"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_standing_stats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="P:3  W:3  Pts:6"
        android:textColor="@color/accent_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
