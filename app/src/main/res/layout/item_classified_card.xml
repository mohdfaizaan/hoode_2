<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_classified_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeColor="@color/border_green_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── Slidable Images Container (Online Shopping Carousel) ── -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp">

            <!-- Slidable ViewPager2 for Multiple Images -->
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/vp_item_images"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_gallery_luxury_gradient" />

            <!-- Single image fallback for backward compatibility -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_classified_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Top Badges Overlay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <!-- Dynamic Status Badge: Available / Booked (24h) / Sold -->
                <TextView
                    android:id="@+id/tv_classified_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/accent_ink"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    tools:text="🟢 AVAILABLE" />

                <TextView
                    android:id="@+id/tv_classified_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_gallery_pill"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/white"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-medium"
                    tools:text="Vehicles" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Type Badge (For Sale / Wanted) -->
                <TextView
                    android:id="@+id/tv_classified_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_neutral"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/text_primary"
                    android:textSize="10.5sp"
                    android:fontFamily="sans-serif-bold"
                    tools:text="FOR SALE" />
            </LinearLayout>

            <!-- Bottom Counter Badge (e.g. 📷 1 / 3) -->
            <TextView
                android:id="@+id/tv_image_count_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_gallery_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:fontFamily="sans-serif-bold"
                tools:text="📷 1 / 3" />
        </FrameLayout>

        <!-- ── Product Details Section ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_classified_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text_primary"
                    android:textSize="21sp"
                    tools:text="₹4,200" />

                <TextView
                    android:id="@+id/tv_classified_area_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    tools:text="Kemmannu Road • Today" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_classified_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                tools:text="Hercules Roadeo 26T 21-Speed Mountain Bicycle" />

            <TextView
                android:id="@+id/tv_classified_seller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                tools:text="👤 Sold by Arshad Hoode (Verified Resident)" />

            <!-- ── Spinny-style 24-Hour Reservation Banner ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_booking_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                tools:visibility="visible"
                app:cardBackgroundColor="#FFFBEB"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:strokeColor="#F59E0B"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:id="@+id/tv_booking_status_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-bold"
                        android:textColor="#B45309"
                        android:textSize="12sp"
                        tools:text="🔒 Spinny Hold: Reserved • 22h 45m left to finalize" />

                    <TextView
                        android:id="@+id/tv_booking_buyer_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#78350F"
                        android:textSize="11.5sp"
                        tools:text="Held by: Faizan • Automatically goes live again after 24h" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Action Buttons Row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Spinny-Style 24h Book Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_book_product"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/accent"
                    android:text="⚡ Book Now (24h Hold)"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="12.5sp"
                    android:fontFamily="sans-serif-bold"
                    app:cornerRadius="12dp" />

                <!-- Cancel Booking (Only shown to the person who booked) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel_booking"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:visibility="gone"
                    tools:visibility="gone"
                    android:text="Cancel My Hold"
                    android:textAllCaps="false"
                    android:textColor="@color/danger"
                    android:textSize="12sp"
                    app:strokeColor="@color/danger"
                    app:cornerRadius="12dp" />

                <!-- Seller Actions: Mark as Sold or Delete (Shown only to Seller) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_mark_sold"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:text="Mark Sold"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="11.5sp"
                    app:strokeColor="@color/border_green"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_delete_listing"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    android:text="Delete"
                    android:textAllCaps="false"
                    android:textColor="@color/danger"
                    android:textSize="11.5sp" />

                <!-- Quick Contact / Inquiry Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_quick_contact"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:text="📞 Call"
                    android:textAllCaps="false"
                    android:textColor="@color/accent"
                    android:textSize="12sp"
                    app:strokeColor="@color/accent"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <!-- Hidden views to preserve compatibility with existing bindings -->
            <TextView
                android:id="@+id/tv_classified_description"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <View
                android:id="@+id/btn_send_inquiry"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
