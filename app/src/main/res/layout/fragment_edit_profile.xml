<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="36dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:background="@drawable/bg_circle_light"
                android:contentDescription="Back"
                android:src="@drawable/ic_arrow_back"
                app:tint="#222222" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Edit Profile"
                android:textColor="@color/profile_text_main"
                android:textSize="22sp"
                android:textStyle="bold" />

        </FrameLayout>

        <!-- COVER & AVATAR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="185dp"
            android:layout_marginTop="14dp">

            <ImageView
                android:id="@+id/ivEditCover"
                android:layout_width="match_parent"
                android:layout_height="135dp"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_cover_placeholder"
                android:contentDescription="Cover Photo" />

            <!-- Edit Cover Button -->
            <ImageButton
                android:id="@+id/btnEditCover"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="end|top"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle_light"
                android:contentDescription="Change Cover"
                android:src="@drawable/ic_edit"
                app:tint="#444444" />

            <!-- Avatar -->
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivEditProfile"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal|bottom"
                android:scaleType="centerCrop"
                android:src="@drawable/profile_placeholder"
                app:shapeAppearanceOverlay="@style/CircleImageStyle"
                app:strokeColor="#FFFFFF"
                app:strokeWidth="4dp"
                android:contentDescription="Profile Picture" />

            <!-- Edit Avatar Button -->
            <ImageButton
                android:id="@+id/btnChangeAvatar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginStart="30dp"
                android:background="@drawable/bg_circle_light"
                android:contentDescription="Change Avatar"
                android:src="@drawable/ic_edit"
                app:tint="#444444" />

        </FrameLayout>

        <TextView
            android:id="@+id/tvHeaderName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Mohammed Suhail"
            android:textColor="@color/profile_text_main"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- ════════ BASIC INFORMATION ════════ -->

        <!-- FULL NAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Full Name"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFullName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/profile_text_main"
            android:textColorHint="#999999" />

        <!-- USERNAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Username"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:hint="Username (e.g. mohammedsuhail)"
            android:inputType="textNoSuggestions"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/profile_text_main"
            android:textColorHint="#999999" />

        <!-- EMAIL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Email Address"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:inputType="textEmailAddress"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/profile_text_main"
            android:textColorHint="#999999" />

        <!-- PHONE -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Phone Number"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPhone"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:inputType="phone"
            android:hint="Phone number"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/profile_text_main"
            android:textColorHint="#999999" />

        <!-- BIO -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Bio"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etBio"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:gravity="top|start"
            android:maxLength="150"
            android:hint="Write a short bio..."
            android:padding="16dp"
            android:textColor="@color/profile_text_main"
            android:textColorHint="#999999" />

        <!-- ════════ COMMUNITY & RESIDENT OPTIONS ════════ -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="COMMUNITY DETAILS"
            android:textColor="@color/profile_text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.06"
            android:textStyle="bold" />

        <!-- LOCALITY / WARD (OPTION SELECTOR) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Locality / Ward"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnSelectLocality"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvLocalityValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Hoode"
                android:textColor="@color/profile_text_main"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#666666" />

        </LinearLayout>

        <!-- BLOOD GROUP (OPTION SELECTOR) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Blood Group (For Emergency Blood Network)"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnSelectBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvBloodGroupValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Blood Group (e.g. O+)"
                android:textColor="@color/profile_text_main"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#666666" />

        </LinearLayout>

        <!-- PROFESSION (OPTION SELECTOR) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Profession"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/btnSelectProfession"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/tvProfessionValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Select Profession"
                android:textColor="@color/profile_text_main"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_down"
                app:tint="#666666" />

        </LinearLayout>

        <!-- FATHER'S NAME -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Father's / Family Name"
            android:textColor="#333333"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFatherName"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_edit_input"
            android:hint="Father's Name"
            android:inputType="textPersonName"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/profile_text_main"
            android:textColorHint="#999999" />

        <!-- SAVE CHANGES -->
        <TextView
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_primary_grey_button"
            android:gravity="center"
            android:text="Save Changes"
            android:textColor="@color/profile_btn_text"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
