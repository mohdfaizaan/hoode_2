<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.8" />

    <!-- Brand Emblem Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="84dp"
        android:layout_height="84dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:background="@drawable/bg_auth_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HC"
                android:textColor="@color/accent"
                android:textSize="30sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.05" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Capsule Badge -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_auth_badge_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp">

        <View
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:background="@drawable/bg_badge_indicator"
            app:backgroundTint="@color/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="COMMUNITY PLATFORM"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.08" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/auth_welcome_title"
        android:textColor="@color/text_primary"
        android:textSize="30sp"
        android:fontFamily="sans-serif-bold"
        android:gravity="center"
        android:letterSpacing="-0.02" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginHorizontal="12dp"
        android:text="@string/auth_welcome_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:gravity="center"
        android:lineSpacingExtra="3sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons Suite -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_google_sign_in"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Continue with Google"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp"
        app:icon="@drawable/ic_google_color"
        app:iconTint="@null"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:cornerRadius="26dp"
        app:backgroundTint="@color/surface"
        app:strokeColor="@color/border_soft"
        app:strokeWidth="1dp"
        app:elevation="1dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sign_in"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="Sign In with Email"
        android:textColor="@color/white"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp"
        android:letterSpacing="0.02"
        app:cornerRadius="26dp"
        app:backgroundTint="@color/accent"
        app:elevation="2dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_sign_up"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/auth_sign_up"
        android:textColor="@color/text_primary"
        android:fontFamily="sans-serif-medium"
        android:textSize="15sp"
        app:cornerRadius="26dp"
        app:backgroundTint="@color/surface"
        app:strokeColor="@color/border_soft"
        app:strokeWidth="1dp"
        app:elevation="1dp" />

    <TextView
        android:id="@+id/btn_guest"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:paddingVertical="8dp"
        android:paddingHorizontal="16dp"
        android:text="Explore as Guest →"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif-bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:text="By continuing, you agree to our Terms of Service &amp; Privacy Policy."
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
