<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_bordered"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_sm"
    android:paddingHorizontal="@dimen/spacing_md"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_ramadan_day"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Day 1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_ramadan_suhoor"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Suhoor: 5:06 AM"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_ramadan_iftar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Iftar: 6:39 PM"
        android:textColor="@color/accent_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
