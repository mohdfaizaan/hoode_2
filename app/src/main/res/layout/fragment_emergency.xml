<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical" android:padding="@dimen/screen_padding_horizontal">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/cd_back" android:focusable="true" android:minHeight="48dp" android:minWidth="48dp" android:clickable="true" android:foreground="?attr/selectableItemBackground" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/feature_emergency" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
        <TextView android:id="@+id/btn_suggest_correction" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_neutral" android:text="Suggest Update" android:textColor="@color/text_primary" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/input_height" android:layout_marginTop="@dimen/spacing_md" android:background="@drawable/bg_search_bar" android:gravity="center_vertical" android:paddingHorizontal="@dimen/spacing_lg" android:orientation="horizontal">
        <ImageView android:layout_width="@dimen/icon_sm" android:layout_height="@dimen/icon_sm" android:src="@drawable/ic_search" android:alpha="0.5" />
        <EditText android:id="@+id/et_search_contacts" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginStart="@dimen/spacing_md" android:background="@null" android:hint="Search emergency &amp; utilities…" android:inputType="text" android:textColor="@color/text_primary" android:textSize="14sp" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:text="Community contacts. Tap a number to open your dialer." android:textColor="@color/text_muted" android:textSize="12sp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/spacing_md">
        <LinearLayout android:id="@+id/ll_contacts_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/spacing_xxxl" />
    </ScrollView>
</LinearLayout>