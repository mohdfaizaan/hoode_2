<?xml version='1.0' encoding='utf-8'?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/profile_bg">
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="never" android:clipChildren="false" android:clipToPadding="false" android:scrollbars="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:paddingBottom="100dp">

            <!-- ── Gradient cover with rounded bottom ───────────── -->
            <FrameLayout android:layout_width="match_parent" android:layout_height="210dp" android:background="@drawable/bg_explore_header" android:clipToOutline="true">
                <ImageView android:id="@+id/ivCover" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/profile_cover_placeholder" android:contentDescription="Profile Cover" />
                <View android:layout_width="match_parent" android:layout_height="28dp" android:layout_gravity="bottom" android:background="@drawable/bg_cover_mask" />
                <TextView android:id="@+id/tvLocalityBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="top|end" android:layout_margin="16dp" android:background="@drawable/bg_cover_badge" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Hoode • Resident" android:textColor="@color/white" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.04" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="bottom|start" android:layout_marginStart="22dp" android:layout_marginBottom="34dp" android:text="RESIDENT PROFILE" android:textSize="10sp" android:textColor="#99FFFFFF" android:fontFamily="sans-serif-medium" android:letterSpacing="0.22" android:textAllCaps="true" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:clipChildren="false" android:clipToPadding="false" android:paddingStart="22dp" android:paddingEnd="22dp">

                <!-- ── Avatar with premium ring ─────────────────── -->
                <FrameLayout android:id="@+id/cardProfileAvatar" android:layout_width="112dp" android:layout_height="112dp" android:layout_gravity="center_horizontal" android:layout_marginTop="-58dp" android:padding="5dp" android:background="@drawable/bg_avatar_ring" android:elevation="6dp">
                    <com.google.android.material.imageview.ShapeableImageView app:shapeAppearanceOverlay="@style/ShapeAppearance.Hoode.Circle" android:id="@+id/ivProfile" android:padding="0dp" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:src="@drawable/profile_placeholder" android:contentDescription="Profile Picture" />
                </FrameLayout>

                <TextView android:id="@+id/tvName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="Your profile" android:textColor="@color/profile_text_main" android:textSize="26sp" android:textStyle="bold" android:fontFamily="sans-serif" />
                <TextView android:id="@+id/tvUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="" android:textColor="@color/accent" android:textSize="14sp" android:fontFamily="sans-serif-medium" />
                <TextView android:id="@+id/tvBio" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginHorizontal="14dp" android:gravity="center" android:text="Connecting with the Hoode community." android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp" />

                <!-- ── Actions ──────────────────────────────────── -->
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/btnEditProfile" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@drawable/bg_btn_accent_pill" android:gravity="center" android:text="Edit profile" android:textColor="@color/white" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" android:minHeight="50dp" android:paddingVertical="13dp" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:stateListAnimator="@null" android:elevation="4dp" />
                    <FrameLayout android:layout_width="50dp" android:layout_height="50dp" android:layout_marginStart="10dp" android:background="@drawable/bg_circle_light">
                        <ImageButton android:id="@+id/btnSettings" android:layout_width="match_parent" android:layout_height="match_parent" android:background="?attr/selectableItemBackgroundBorderless" android:contentDescription="Settings" android:src="@drawable/ic_settings" app:tint="@color/accent" android:padding="13dp" />
                    </FrameLayout>
                </LinearLayout>

                <!-- ── Stats ────────────────────────────────────── -->
                <LinearLayout android:id="@+id/statsCard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/bg_profile_card" android:gravity="center" android:orientation="horizontal" android:minHeight="92dp" android:paddingVertical="18dp">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvStatPosts" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/accent" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="SUBMISSIONS" android:textColor="@color/profile_text_secondary" android:textSize="10sp" android:letterSpacing="0.1" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="42dp" android:background="@color/border_soft" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvStatConnections" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/warning" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="PENDING" android:textColor="@color/profile_text_secondary" android:textSize="10sp" android:letterSpacing="0.1" />
                    </LinearLayout>
                    <View android:layout_width="1dp" android:layout_height="42dp" android:background="@color/border_soft" />
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                        <TextView android:id="@+id/tvStatContributions" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/success" android:textSize="22sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="APPROVED" android:textColor="@color/profile_text_secondary" android:textSize="10sp" android:letterSpacing="0.1" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── Profile completion ───────────────────────── -->
                <LinearLayout android:id="@+id/cardProfileCompletion" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card_accent_soft" android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                        <FrameLayout android:layout_width="34dp" android:layout_height="34dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/surface">
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="center" android:src="@drawable/ic_verified" app:tint="@color/accent" />
                        </FrameLayout>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="Profile Completion" android:textColor="@color/profile_text_main" android:textSize="15sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" />
                        <TextView android:id="@+id/tvCompletionPercentage" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="" android:textColor="@color/accent" android:textSize="16sp" android:textStyle="bold" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/pbProfileCompletion" style="@android:style/Widget.ProgressBar.Horizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" android:max="100" android:progress="0" android:progressDrawable="@drawable/bg_progress_bar_custom" />
                    <TextView android:id="@+id/tvCompletionTip" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Complete your profile to help the community get to know you." android:textColor="@color/profile_text_secondary" android:textSize="12sp" />
                    <TextView android:id="@+id/btnCompleteProfile" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="10dp" android:background="@drawable/bg_btn_white_pill" android:gravity="center" android:paddingHorizontal="18dp" android:text="Complete Profile →" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:minHeight="44dp" android:paddingVertical="10dp" android:focusable="true" android:foreground="?attr/selectableItemBackground" />
                </LinearLayout>

                <com.google.android.material.tabs.TabLayout android:id="@+id/profileTabs" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="14dp" android:background="@android:color/transparent" app:tabIndicatorColor="@color/accent" app:tabIndicator="@drawable/bg_tab_indicator" app:tabIndicatorHeight="3dp" app:tabIndicatorFullWidth="false" app:tabRippleColor="@android:color/transparent" app:tabSelectedTextColor="@color/accent" app:tabTextColor="@color/text_secondary" app:tabMode="fixed" app:tabGravity="center" app:tabMinWidth="90dp" android:paddingTop="6dp" />
                <LinearLayout android:id="@+id/feedContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="vertical" />

                <!-- ── Resident details ─────────────────────────── -->
                <LinearLayout android:id="@+id/cardResidentDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_profile_card" android:orientation="vertical" android:padding="18dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:drawableStart="@drawable/bg_section_accent_bar" android:drawablePadding="8dp" android:gravity="center_vertical" android:text="RESIDENT DETAILS" android:textColor="@color/profile_text_main" android:textSize="13sp" android:fontFamily="sans-serif-medium" android:textStyle="bold" android:letterSpacing="0.12" android:textAllCaps="true" />
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="12dp" android:layout_marginBottom="4dp" android:background="@color/border_faint" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_phone" app:tint="@color/accent" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Phone" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailPhone" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Not provided" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_mail" app:tint="@color/accent" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Email" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailEmail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Not provided" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_community" app:tint="@color/accent" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Locality / Ward" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailLocality" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Hoode" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_blood" app:tint="@color/danger" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Blood Group" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailBloodGroup" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Not provided" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_jobs" app:tint="@color/accent" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Profession" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailProfession" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Not provided" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_person" app:tint="@color/accent" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Father's Name" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailFatherName" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Not provided" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingVertical="8dp">
                        <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/ic_crown" app:tint="@color/warning" />
                        <TextView android:layout_width="110dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="Resident Status" android:textColor="@color/profile_text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tvDetailStatus" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Resident" android:textColor="@color/profile_text_main" android:textSize="13sp" android:textStyle="bold" android:gravity="end" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
