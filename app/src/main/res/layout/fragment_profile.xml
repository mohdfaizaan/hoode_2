<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/profile_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <!-- COVER IMAGE -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="205dp">

                <ImageView
                    android:id="@+id/ivCover"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_cover_placeholder"
                    android:contentDescription="Profile Cover" />

                <!-- Locality Pill on Cover -->
                <TextView
                    android:id="@+id/tvLocalityBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_small_header_button"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:text="Hoode • Verified Resident"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </FrameLayout>

            <!-- PROFILE CONTENT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:paddingStart="18dp"
                android:paddingEnd="18dp">

                <!-- Avatar overlapping Cover - In TOP layer with prominent black radius -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ivProfile"
                    android:layout_width="104dp"
                    android:layout_height="104dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="-52dp"
                    android:elevation="24dp"
                    android:translationZ="24dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/profile_placeholder"
                    app:shapeAppearanceOverlay="@style/CircleImageStyle"
                    app:strokeColor="#000000"
                    app:strokeWidth="4dp"
                    android:contentDescription="Profile Picture" />

                <!-- User Full Name -->
                <TextView
                    android:id="@+id/tvName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Mohammed Suhail"
                    android:textColor="@color/profile_text_main"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <!-- Username -->
                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:text="\@mohammedsuhail"
                    android:textColor="@color/profile_text_secondary"
                    android:textSize="14sp" />

                <!-- Short Bio -->
                <TextView
                    android:id="@+id/tvBio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="Connecting with the Hoode community."
                    android:textColor="#555555"
                    android:textSize="13sp" />

                <!-- PROFILE COMPLETION CARD -->
                <LinearLayout
                    android:id="@+id/cardProfileCompletion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_profile_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_verified"
                            app:tint="@color/profile_text_main" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Profile Completion"
                            android:textColor="@color/profile_text_main"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvCompletionPercentage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="75%"
                            android:textColor="@color/profile_text_main"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Horizontal Progress Bar -->
                    <ProgressBar
                        android:id="@+id/pbProfileCompletion"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:layout_marginTop="10dp"
                        android:max="100"
                        android:progress="75"
                        android:progressDrawable="@drawable/bg_progress_bar_custom" />

                    <!-- Completion Tip / Next step -->
                    <TextView
                        android:id="@+id/tvCompletionTip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Add your blood group and father's name to reach 100%!"
                        android:textColor="@color/profile_text_secondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnCompleteProfile"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="end"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_chip_black_border"
                        android:gravity="center"
                        android:paddingHorizontal="14dp"
                        android:text="Complete Profile →"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- STATS CARD -->
                <LinearLayout
                    android:id="@+id/statsCard"
                    android:layout_width="match_parent"
                    android:layout_height="78dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_profile_card"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <!-- Posts -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatPosts"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/profile_text_main"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Posts"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:background="#E8E8E8" />

                    <!-- Connections -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatConnections"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="126"
                            android:textColor="@color/profile_text_main"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Connections"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <View
                        android:layout_width="1dp"
                        android:layout_height="40dp"
                        android:background="#E8E8E8" />

                    <!-- Contributions -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvStatContributions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="78"
                            android:textColor="@color/profile_text_main"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Contributions"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- RESIDENT DETAILS CARD -->
                <LinearLayout
                    android:id="@+id/cardResidentDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_profile_card"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resident Profile Details"
                        android:textColor="@color/profile_text_main"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="#EEEEEE" />

                    <!-- Detail Row: Phone -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_phone"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Phone"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailPhone"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Not provided"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Detail Row: Email -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_mail"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Email"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="user@example.com"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Detail Row: Locality / Ward -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_community"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Locality / Ward"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailLocality"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Hoode"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Detail Row: Blood Group -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_blood"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Blood Group"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailBloodGroup"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Not provided"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Detail Row: Profession -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_jobs"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Profession"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailProfession"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Not provided"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Detail Row: Father's Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_person"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Father's Name"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailFatherName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Not provided"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Detail Row: Resident Status -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingVertical="5dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_crown"
                            app:tint="@color/profile_text_secondary" />

                        <TextView
                            android:layout_width="110dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Resident Status"
                            android:textColor="@color/profile_text_secondary"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/tvDetailStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Verified Resident • Active"
                            android:textColor="@color/profile_text_main"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:gravity="end" />
                    </LinearLayout>

                </LinearLayout>

                <!-- EDIT PROFILE + SETTINGS BUTTONS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnEditProfile"
                        android:layout_width="0dp"
                        android:layout_height="50dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_primary_grey_button"
                        android:gravity="center"
                        android:text="✎  Edit Profile"
                        android:textColor="@color/profile_btn_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnSettings"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_circle_light"
                        android:contentDescription="Settings"
                        android:src="@drawable/ic_settings"
                        app:tint="#333333" />

                </LinearLayout>

                <!-- TABS -->
                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/profileTabs"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="14dp"
                    android:background="@android:color/transparent"
                    app:tabIndicatorColor="@color/profile_accent_dark"
                    app:tabIndicatorHeight="2.5dp"
                    app:tabRippleColor="@android:color/transparent"
                    app:tabSelectedTextColor="@color/profile_text_main"
                    app:tabTextColor="#999999" />

                <!-- FEED CONTENT CONTAINER -->
                <LinearLayout
                    android:id="@+id/feedContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</FrameLayout>
