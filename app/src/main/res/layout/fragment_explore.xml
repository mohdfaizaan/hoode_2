<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">

    <!-- ── Gradient hero header ─────────────────────────────── -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_explore_header" android:orientation="vertical" android:paddingTop="24dp" android:paddingHorizontal="22dp" android:paddingBottom="22dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="HOODE CONNECT" android:textSize="11sp" android:textColor="@color/on_hero_secondary" android:fontFamily="sans-serif-medium" android:letterSpacing="0.22" android:textAllCaps="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Explore Hoode" android:textSize="30sp" android:textColor="@color/white" android:fontFamily="sans-serif" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Everything our community offers, in one place." android:textSize="13sp" android:textColor="@color/on_hero_secondary" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="18dp" android:background="@drawable/bg_search_bar" android:elevation="6dp" android:gravity="center_vertical" android:paddingHorizontal="@dimen/spacing_lg" android:orientation="horizontal">
            <ImageView android:layout_width="@dimen/icon_sm" android:layout_height="@dimen/icon_sm" android:src="@drawable/ic_search" app:tint="@color/text_secondary" xmlns:app="http://schemas.android.com/apk/res-auto" android:alpha="0.7" />
            <EditText android:id="@+id/et_explore_search" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_md" android:background="@null" android:hint="Search services, places and more" android:textColor="@color/text_primary" android:textColorHint="@color/text_muted" android:textSize="@dimen/text_body" android:imeOptions="actionSearch" android:inputType="text" android:maxLines="1" />
            <ImageView android:id="@+id/btn_clear_search" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_close" android:visibility="gone" android:alpha="0.5" android:padding="14dp" android:contentDescription="Clear search" android:focusable="true" android:background="?attr/selectableItemBackgroundBorderless" android:minHeight="48dp" android:minWidth="48dp" android:clickable="true" android:foreground="?attr/selectableItemBackground" />
        </LinearLayout>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:id="@+id/scroll_explore" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:overScrollMode="never">
        <LinearLayout android:id="@+id/ll_explore_categories" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/bottom_nav_content_padding">

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No matches. Try a service or place name." android:textSize="15sp" android:textColor="@color/text_secondary" android:id="@+id/tvSearchEmpty" android:padding="22dp" android:visibility="gone" android:accessibilityLiveRegion="polite" />

            <!-- ── Essentials: spotlight hero cards ─────────── -->
            <TextView android:id="@+id/header_essentials" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="@string/explore_essentials" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_hero" android:id="@+id/feature_prayer" android:layout_width="0dp" android:layout_height="160dp" android:layout_weight="1" />
                <include layout="@layout/item_explore_hero" android:id="@+id/feature_emergency" android:layout_width="0dp" android:layout_height="160dp" android:layout_weight="1" android:layout_marginStart="12dp" />
            </LinearLayout>

            <!-- ── Faith & Time ─────────────────────────────── -->
            <TextView android:id="@+id/header_faith" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="@string/explore_faith_time" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_ramadan" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_calendar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- ── Community ────────────────────────────────── -->
            <TextView android:id="@+id/header_community" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="@string/explore_community" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_events" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_activities" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_tournaments" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_news" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- ── Learning & People ────────────────────────── -->
            <TextView android:id="@+id/header_learning" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="@string/explore_learning_people" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_education" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_huffaz" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_personality" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_gallery" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" />
                <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- ── Work & Services ──────────────────────────── -->
            <TextView android:id="@+id/header_opportunities" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="@string/explore_work_services" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_jobs" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_marketplace" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_providers" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_blood" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_lost_found" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>

            <!-- ── Civic Voice & Rewards ────────────────────── -->
            <TextView android:id="@+id/header_civic" android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="@string/explore_civic_rewards" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_polls" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" />
                <include layout="@layout/item_explore_feature" android:id="@+id/feature_badges" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
