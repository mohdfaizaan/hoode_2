<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- ═══ Premium Header ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="20dp"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_prayer"
                    android:layout_marginEnd="8dp"
                    app:tint="@color/accent_dark"
                    android:contentDescription="@null" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prayer &amp; Iqamah"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_rhythm_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent_soft"
            android:text="● DAILY RHYTHM"
            android:textColor="@color/accent_ink"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.06" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/spacing_massive">

            <!-- ═══ Prayer Panel Card ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_prayer_panel_card"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="16dp">

                <!-- ── Mosque Name & Switch Button ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_mosque_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hoode Juma Masjid"
                            android:textColor="@color/accent_ink"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.01" />

                        <TextView
                            android:id="@+id/tv_mosque_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Bengre Road, Hoode · IST"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_change_mosque"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_pill_neutral"
                        android:text="Switch Mosque"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>

                <!-- ── Countdown Ring + Next Prayer Focus ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Countdown Ring -->
                    <FrameLayout
                        android:layout_width="180dp"
                        android:layout_height="180dp">

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/prayer_ring"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_gravity="center"
                            android:progress="68"
                            app:indicatorColor="@color/accent_dark"
                            app:indicatorSize="180dp"
                            app:trackColor="@color/prayer_ring_track"
                            app:trackCornerRadius="8dp"
                            app:trackThickness="6dp" />

                        <!-- Inner Circle Content -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IQAMAH IN"
                                android:textColor="@color/text_muted"
                                android:textSize="10sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.12" />

                            <TextView
                                android:id="@+id/tv_countdown_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="01:14:38"
                                android:textColor="@color/text_primary"
                                android:textSize="26sp"
                                android:fontFamily="sans-serif"
                                android:letterSpacing="-0.02" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="HRS · MIN · SEC"
                                android:textColor="@color/text_muted"
                                android:textSize="9sp"
                                android:fontFamily="sans-serif-medium"
                                android:letterSpacing="0.06" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- Next Prayer Info -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="16dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_next_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_pill_accent_soft"
                            android:text="UP NEXT"
                            android:textColor="@color/accent_ink"
                            android:textSize="10sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="0.08" />

                        <TextView
                            android:id="@+id/tv_next_prayer_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Maghrib"
                            android:textColor="@color/text_primary"
                            android:textSize="32sp"
                            android:fontFamily="sans-serif-medium"
                            android:letterSpacing="-0.03" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_prayer"
                                app:tint="@color/accent_dark"
                                android:layout_marginEnd="5dp"
                                android:contentDescription="@null" />

                            <TextView
                                android:id="@+id/tv_hero_iqamah"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Iqamah 6:42 PM"
                                android:textColor="@color/accent_dark"
                                android:textSize="13sp"
                                android:fontFamily="sans-serif-medium" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/btn_view_timetable"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/touch_target_min"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:text="Full Timetable ↗"
                            android:textColor="@color/text_muted"
                            android:textSize="12sp"
                            android:fontFamily="sans-serif-medium"
                            android:background="?attr/selectableItemBackground" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ── 5-Column Prayer Times Strip ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#12000000" />

                    <LinearLayout
                        android:id="@+id/ll_prayer_strip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false" />
                </LinearLayout>

                <!-- ── Note ── -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Mosque verified timings"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IST"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium" />
                </LinearLayout>
            </LinearLayout>

            <!-- ═══ Daily Timings & Iqamah Section ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Daily Timings &amp; Iqamah"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Timetable Rows Container -->
            <LinearLayout
                android:id="@+id/ll_timings_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />

            <!-- ═══ Manage Reminders Button ═══ -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_reminders"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height_primary"
                android:layout_marginTop="24dp"
                android:text="@string/prayer_manage_reminders"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                app:cornerRadius="@dimen/radius_button"
                app:backgroundTint="@color/accent_ink"
                app:icon="@drawable/ic_notification_bell"
                app:iconGravity="textStart"
                app:iconTint="@color/white"
                app:iconSize="18dp"
                app:iconPadding="8dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
