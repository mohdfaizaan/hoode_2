<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical" android:padding="@dimen/screen_padding_horizontal">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/cd_back" android:focusable="true" android:minHeight="48dp" android:minWidth="48dp" android:clickable="true" android:foreground="?attr/selectableItemBackground" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/feature_badges" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/spacing_md">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/spacing_xxxl">
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="@dimen/radius_card" app:cardElevation="3dp" app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_bordered" android:gravity="center" android:orientation="vertical" android:padding="@dimen/spacing_xxl">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMMUNITY POINTS" android:textColor="@color/accent_ink" android:textSize="12sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_total_points" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="320" android:textColor="@color/text_primary" android:textSize="44sp" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Points from your approved community contributions." android:textColor="@color/text_secondary" android:textSize="13sp" android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xl" android:text="Earned &amp; Available Badges" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/ll_badges_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:orientation="vertical" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xl" android:text="Contribution history" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/ll_contributions_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>