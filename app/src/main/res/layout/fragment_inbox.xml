<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/inbox_title"
            android:textAppearance="@style/TextAppearance.Hoode.Headline"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/tv_unread_counter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_accent"
            android:paddingHorizontal="@dimen/spacing_md"
            android:paddingVertical="@dimen/spacing_xxs"
            android:text="2 Unread"
            android:textColor="@color/accent_ink"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:layout_marginTop="2dp"
        android:text="Private resident inquiries, marketplace buyer chats, and official updates."
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <!-- Filter Chips Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding_horizontal">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chip_group_inbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_all"
                style="@style/Widget.Hoode.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="All Chats" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_marketplace"
                style="@style/Widget.Hoode.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marketplace" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_blood"
                style="@style/Widget.Hoode.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Blood Network" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_jobs"
                style="@style/Widget.Hoode.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jobs &amp; Gigs" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_support"
                style="@style/Widget.Hoode.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Civic &amp; Support" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Scrollable Conversations List -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_sm">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingBottom="@dimen/spacing_xxxl">

            <!-- Dynamic Conversation Cards Container -->
            <LinearLayout
                android:id="@+id/ll_conversations"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Empty State (Shown when no matching messages) -->
            <LinearLayout
                android:id="@+id/empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/spacing_xxxl"
                android:visibility="gone">

                <ImageView
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/ic_nav_inbox"
                    android:alpha="0.2" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:text="@string/inbox_empty"
                    android:textAppearance="@style/TextAppearance.Hoode.Title"
                    android:gravity="center" />

                <TextView
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:text="@string/inbox_empty_desc"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
