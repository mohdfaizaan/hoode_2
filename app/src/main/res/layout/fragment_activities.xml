<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding_horizontal">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_lg"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="@dimen/spacing_sm"
            android:src="@drawable/ic_arrow_back"
            android:contentDescription="@string/cd_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/spacing_sm"
            android:text="@string/feature_activities"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 4 Required Category Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_md"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/ll_activity_filters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/filter_act_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="All"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/filter_act_religious"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Religious"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/filter_act_community"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Community"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/filter_act_social"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Social"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/filter_act_sports"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Sports"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/filter_act_condolences"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/spacing_sm"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Condolences"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/filter_act_dua"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="14dp"
                android:paddingVertical="7dp"
                android:text="Dua Request"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </HorizontalScrollView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/spacing_md">

        <LinearLayout
            android:id="@+id/ll_activities_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_xxxl" />
    </ScrollView>

</LinearLayout>
