<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical" android:paddingHorizontal="@dimen/screen_padding_horizontal">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/btn_back" android:layout_width="48dp" android:layout_height="48dp" android:background="?attr/selectableItemBackgroundBorderless" android:padding="12dp" android:src="@drawable/ic_arrow_back" android:contentDescription="@string/cd_back" android:focusable="true" android:minHeight="48dp" android:minWidth="48dp" android:clickable="true" android:foreground="?attr/selectableItemBackground" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_sm" android:text="@string/feature_blood" android:textColor="@color/text_primary" android:textSize="28sp" android:textStyle="bold" android:fontFamily="sans-serif-condensed" />
        <TextView android:id="@+id/btn_request_blood" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/spacing_xs" android:background="@drawable/bg_pill_accent" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="+ Request" android:textColor="@color/accent_ink" android:textSize="11sp" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
        <TextView android:id="@+id/btn_join_donor_registry" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill_danger" android:paddingHorizontal="12dp" android:paddingVertical="6dp" android:text="Join Donor" android:textColor="@color/danger" android:textSize="11sp" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="Coordinated emergency network • Donors contacted only with explicit consent • No public phone leaks" android:textColor="@color/text_muted" android:textSize="11sp" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingVertical="@dimen/spacing_xs">
            <TextView android:id="@+id/chip_blood_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_chip_selected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="All Groups" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
            <TextView android:id="@+id/chip_blood_o_pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="O+" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
            <TextView android:id="@+id/chip_blood_b_pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="B+" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
            <TextView android:id="@+id/chip_blood_a_pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="A+" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
            <TextView android:id="@+id/chip_blood_ab_pos" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="AB+" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
            <TextView android:id="@+id/chip_blood_neg" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/spacing_xs" android:background="@drawable/bg_chip_unselected" android:paddingHorizontal="14dp" android:paddingVertical="6dp" android:text="Negative / Rare" android:textColor="@color/text_secondary" android:textSize="12sp" android:minHeight="48dp" android:minWidth="48dp" android:focusable="true" android:clickable="true" android:foreground="?attr/selectableItemBackground" android:gravity="center" />
        </LinearLayout>
    </HorizontalScrollView>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="@dimen/spacing_sm">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/spacing_xxxl">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Urgent Blood Needs" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/ll_blood_requests_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_sm" android:orientation="vertical" />
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_lg" app:cardCornerRadius="@dimen/radius_card" app:cardElevation="2dp" app:cardBackgroundColor="@color/surface">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_card_bordered" android:padding="@dimen/spacing_lg" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Community Donor Registry" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_donor_network_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="Volunteer to help someone nearby." android:textColor="@color/accent_ink" android:textSize="13sp" android:fontFamily="sans-serif-medium" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/spacing_xs" android:text="Register your blood group and contact details. The community team reviews donor registrations." android:textColor="@color/text_secondary" android:textSize="12sp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>