<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_md"
    app:cardCornerRadius="@dimen/radius_card"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_bordered"
        android:padding="@dimen/spacing_lg"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_job_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_accent"
                android:text="Full-time"
                android:textColor="@color/accent_ink"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_job_sponsored"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_sm"
                android:background="@drawable/bg_sponsored_badge"
                android:text="Sponsored"
                android:textColor="@color/text_muted"
                android:textSize="10sp"
                android:visibility="gone" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tv_job_applicants"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4 applied"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_job_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Assistant Accountant"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_job_employer_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Hoode Fisheries Co-Op • Hoode Port Road"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tv_job_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="Looking for B.Com graduate with Tally ERP experience for daily ledger maintenance."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="2sp" />

        <!-- Pay and Apply Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_job_pay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹18,000 – ₹22,000 / mo"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_job_deadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Closes 25 Sep 2026"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_apply_job"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Apply Now"
                android:textColor="@color/border_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="@dimen/radius_control"
                app:backgroundTint="@color/accent"
                app:strokeColor="@color/border_primary"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
