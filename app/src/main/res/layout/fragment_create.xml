<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background" android:orientation="vertical">

    <!-- ── Gradient hero header ─────────────────────────────── -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_explore_header" android:orientation="vertical" android:paddingTop="24dp" android:paddingHorizontal="22dp" android:paddingBottom="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="RESIDENT HUB" android:textSize="11sp" android:textColor="@color/on_hero_secondary" android:fontFamily="sans-serif-medium" android:letterSpacing="0.22" android:textAllCaps="true" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Create &amp; Share" android:textSize="30sp" android:textColor="@color/white" android:fontFamily="sans-serif" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Announce, sell, hire and request — reach all of Hoode." android:textSize="13sp" android:textColor="@color/on_hero_secondary" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="@dimen/bottom_nav_content_padding">

            <!-- ── Lifesaver hero ───────────────────────────── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="Lifesaver" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_create_blood" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_padding_horizontal" app:cardCornerRadius="22dp" app:cardElevation="3dp" app:strokeWidth="0dp" app:cardBackgroundColor="@color/hero_danger_end" app:cardPreventCornerOverlap="false" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_hero_emergency" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                    <FrameLayout android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/bg_hero_icon_disc">
                        <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:layout_gravity="center" android:src="@drawable/ic_blood" app:tint="@color/white" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="URGENT · LIFESAVER" android:textSize="9sp" android:textColor="#CCFFFFFF" android:fontFamily="sans-serif-medium" android:letterSpacing="0.14" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Raise Urgent Blood Request" android:textColor="@color/white" android:textSize="16sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Alert voluntary Hoode donors &amp; hospital coordinators" android:textColor="@color/on_hero_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/icon_sm" android:layout_height="@dimen/icon_sm" android:src="@drawable/ic_chevron_right" app:tint="@color/white" android:alpha="0.85" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Post to the community ────────────────────── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="Post to the community" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_create_classified" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/border_soft" app:strokeWidth="@dimen/card_stroke" app:cardBackgroundColor="@color/surface" app:contentPadding="0dp" app:cardPreventCornerOverlap="false" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingTop="16dp" android:paddingBottom="14dp">
                        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/surface_dim">
                            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:layout_gravity="center" android:src="@drawable/ic_classified" app:tint="@color/accent" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Marketplace" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Sell, buy or give away items" android:textColor="@color/text_secondary" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_create_event" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/border_soft" app:strokeWidth="@dimen/card_stroke" app:cardBackgroundColor="@color/surface" app:contentPadding="0dp" app:cardPreventCornerOverlap="false" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingTop="16dp" android:paddingBottom="14dp">
                        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/success_soft">
                            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:layout_gravity="center" android:src="@drawable/ic_events" app:tint="@color/success" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Event or Wedding" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Announce gatherings &amp; nikah cards" android:textColor="@color/text_secondary" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:paddingHorizontal="@dimen/screen_padding_horizontal">
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_create_job" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/border_soft" app:strokeWidth="@dimen/card_stroke" app:cardBackgroundColor="@color/surface" app:contentPadding="0dp" app:cardPreventCornerOverlap="false" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingTop="16dp" android:paddingBottom="14dp">
                        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/warning_soft">
                            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:layout_gravity="center" android:src="@drawable/ic_jobs" app:tint="@color/warning" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Job or Gig" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Hire drivers, tutors &amp; craftsmen" android:textColor="@color/text_secondary" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/card_create_lost_found" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/border_soft" app:strokeWidth="@dimen/card_stroke" app:cardBackgroundColor="@color/surface" app:contentPadding="0dp" app:cardPreventCornerOverlap="false" android:clickable="true" android:focusable="true">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="10dp" android:paddingTop="16dp" android:paddingBottom="14dp">
                        <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/navy_soft">
                            <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:layout_gravity="center" android:src="@drawable/ic_search" app:tint="@color/navy" />
                        </FrameLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="Lost &amp; Found" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Reunite keys, wallets &amp; documents" android:textColor="@color/text_secondary" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ── Civic voice ──────────────────────────────── -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" style="@style/Widget.Hoode.Explore.SectionHeader" android:text="Civic voice" />
            <com.google.android.material.card.MaterialCardView android:id="@+id/card_create_civic" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="@dimen/screen_padding_horizontal" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/border_soft" app:strokeWidth="@dimen/card_stroke" app:cardBackgroundColor="@color/surface" app:contentPadding="16dp" app:cardPreventCornerOverlap="false" android:clickable="true" android:focusable="true">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <FrameLayout android:layout_width="46dp" android:layout_height="46dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/surface_dim">
                        <ImageView android:layout_width="@dimen/icon_md" android:layout_height="@dimen/icon_md" android:layout_gravity="center" android:src="@drawable/ic_poll" app:tint="@color/accent" />
                    </FrameLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Submit Civic Issue or Proposal" android:textColor="@color/text_primary" android:textSize="15sp" android:textStyle="bold" android:fontFamily="sans-serif-medium" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Roads, streetlights, drainage &amp; cleanliness drives" android:textColor="@color/text_secondary" android:textSize="12sp" />
                    </LinearLayout>
                    <ImageView android:layout_width="@dimen/icon_sm" android:layout_height="@dimen/icon_sm" android:src="@drawable/ic_chevron_right" android:alpha="0.4" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Trust note ───────────────────────────────── -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:layout_marginHorizontal="@dimen/screen_padding_horizontal" android:background="@drawable/bg_card_accent_soft" android:padding="@dimen/spacing_lg" android:gravity="center_vertical" android:orientation="horizontal">
                <FrameLayout android:layout_width="38dp" android:layout_height="38dp" android:background="@drawable/bg_icon_chip" android:backgroundTint="@color/surface">
                    <ImageView android:layout_width="@dimen/icon_sm" android:layout_height="@dimen/icon_sm" android:layout_gravity="center" android:src="@drawable/ic_check" app:tint="@color/success" />
                </FrameLayout>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/spacing_md" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Community Trust &amp; Moderation" android:textColor="@color/text_primary" android:textSize="@dimen/text_sm" android:textStyle="bold" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Submissions are reviewed by the Hoode Council to preserve privacy, safety and authenticity." android:textColor="@color/text_secondary" android:textSize="@dimen/text_xs" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
