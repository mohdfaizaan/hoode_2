<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/row_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_timetable_row"
    android:gravity="center_vertical"
    android:paddingVertical="14dp"
    android:paddingHorizontal="16dp"
    android:orientation="horizontal">

    <!-- Prayer Icon Circle -->
    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_prayer_time_inactive">

        <ImageView
            android:id="@+id/iv_row_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_prayer"
            app:tint="@color/text_muted"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Prayer Name -->
    <TextView
        android:id="@+id/tv_row_prayer_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:text="Fajr"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:fontFamily="sans-serif-medium" />

    <!-- Adhan Time -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:layout_marginEnd="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Starts"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_row_adhan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="5:12 AM"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif" />
    </LinearLayout>

    <!-- Iqamah Time -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Iqamah"
            android:textColor="@color/text_muted"
            android:textSize="10sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tv_row_iqamah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="5:30 AM"
            android:textColor="@color/accent_ink"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>
