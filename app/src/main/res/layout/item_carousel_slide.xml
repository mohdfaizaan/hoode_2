<?xml version="1.0" encoding="utf-8"?>
<!--
  Root is MaterialCardView so cardCornerRadius clips all children
  including the banner image — this eliminates the corner glitch
  when swiping between carousel slides.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true"
    android:clipChildren="true"
    android:outlineProvider="background"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:cardPreventCornerOverlap="true"
    app:strokeWidth="0dp">

    <FrameLayout
        android:id="@+id/fl_slide_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true"
        android:background="@drawable/bg_carousel_gradient">

        <!-- Remote Image Loaded from Internet -->
        <ImageView
            android:id="@+id/iv_carousel_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="Sponsored Visual" />

        <!-- Dark Gradient Scrim Overlay for Readability -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_carousel_gradient"
            android:alpha="0.82" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingTop="@dimen/spacing_xl"
            android:paddingBottom="@dimen/spacing_xl"
            android:paddingEnd="120dp">

            <TextView
                android:id="@+id/tv_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="@dimen/text_title"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Welcome to Hoode Connect" />

            <TextView
                android:id="@+id/tv_subheadline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/text_sm"
                android:maxLines="2"
                android:ellipsize="end"
                tools:text="Your community, connected" />

            <TextView
                android:id="@+id/tv_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:textColor="#99FFFFFF"
                android:textSize="@dimen/text_xs"
                android:fontFamily="sans-serif-medium"
                tools:text="Hoode Community Services" />
        </LinearLayout>

        <!-- CTA button in bottom right -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginBottom="@dimen/spacing_lg"
            android:visibility="visible"
            style="@style/Widget.Hoode.Button.Accent"
            android:textSize="@dimen/text_xs"
            android:minHeight="@dimen/button_height_sm"
            android:paddingHorizontal="12dp"
            android:text="Know More"
            tools:text="Know More" />

    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
