<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_carousel_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/spacing_xl">

        <TextView
            android:id="@+id/tv_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:textSize="@dimen/text_title"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Welcome to Hoode Connect" />

        <TextView
            android:id="@+id/tv_subheadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/text_sm"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Your community, connected" />

        <TextView
            android:id="@+id/tv_advertiser"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:textColor="#99FFFFFF"
            android:textSize="@dimen/text_xs"
            android:fontFamily="sans-serif-medium"
            tools:text="Hoode Community Services" />
    </LinearLayout>

    <!-- Optional CTA button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/spacing_lg"
        android:visibility="gone"
        style="@style/Widget.Hoode.Button.Accent"
        android:textSize="@dimen/text_sm"
        android:minHeight="@dimen/button_height_sm"
        tools:text="Learn More"
        tools:visibility="visible" />

</FrameLayout>
