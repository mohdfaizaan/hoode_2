<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card_bordered"
    android:gravity="center_vertical"
    android:paddingVertical="@dimen/spacing_sm"
    android:paddingHorizontal="@dimen/spacing_md"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_contrib_action"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Joined Blood Donor Registry"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_contrib_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:text="08 Sep"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_contrib_points"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+50 pts"
        android:textColor="@color/success"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
